{
  "compilerOptions": {
    "target": "ES2023", "module": "CommonJS", "moduleResolution": "Node",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true,
    "types": ["node"], "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
